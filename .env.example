LIMESURVEY_URL=https://survey.example.com/index.php/admin/remotecontrol
LIMESURVEY_USERNAME=rpc-user
LIMESURVEY_PASSWORD=replace-me
# Alternative to LIMESURVEY_PASSWORD: path to a file that holds only the password (UTF-8 without BOM; a BOM and a
# trailing line ending are removed, UTF-16 is rejected). Keeps the password out of the MCP client configuration.
# If both are set, the file wins, LIMESURVEY_PASSWORD is ignored and a startup warning names both variables.
# On Unix restrict the file with chmod 600; on Windows with icacls (docs/INSTALLATION.md, "Store the password in a file").
# LIMESURVEY_PASSWORD_FILE=
LIMESURVEY_AUTH_PLUGIN=Authdb
LIMESURVEY_TIMEOUT_MS=30000
LIMESURVEY_MAX_RESPONSE_CHARS=50000
# Legacy switch: LIMESURVEY_READ_ONLY=true equals LIMESURVEY_WRITE_SCOPE=none. Prefer the write scope below.
# LIMESURVEY_READ_ONLY=false
# Write scope: none | content | lifecycle | outreach (cumulative). Empty = everything allowed.
# none = read-only, content = build/correct surveys, lifecycle = also activate/delete, outreach = also participants, responses, email.
# If both LIMESURVEY_READ_ONLY and LIMESURVEY_WRITE_SCOPE are set, the stricter level wins (startup warning).
LIMESURVEY_WRITE_SCOPE=
LIMESURVEY_EXPORT_DIR=./exports
LIMESURVEY_MAX_EXPORT_BYTES=104857600
# Directory for import_data_path reads. Falls back to LIMESURVEY_EXPORT_DIR when unset.
LIMESURVEY_IMPORT_DIR=./imports
LIMESURVEY_MAX_IMPORT_BYTES=52428800
LIMESURVEY_THEME_DIR=./themes
LIMESURVEY_MAX_THEME_ASSET_BYTES=5242880
# Enables the non-standard list_response_exports method only when the matching LimeSurvey extension is installed.
LIMESURVEY_ENABLE_EXPERIMENTAL_METHODS=false
# Set to true only for a trusted development instance using plain HTTP.
LIMESURVEY_ALLOW_INSECURE_HTTP=false

# stdio is the secure default for a local MCP client. Use http for remote/container operation.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
# Required for non-loopback HTTP bindings.
MCP_HTTP_BEARER_TOKEN=
# Comma-separated exact values. Configure both when exposing HTTP through a reverse proxy or browser.
MCP_HTTP_ALLOWED_HOSTS=
MCP_HTTP_ALLOWED_ORIGINS=
